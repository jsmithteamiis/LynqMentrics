{
  "DatabaseProvider": "Sqlite",
  "Database": {
    "Provider": "Sqlite",
    "Sqlite": {
      "ConnectionStringName": "DefaultConnection",
      "CommandTimeoutSeconds": 30
    },
    "PostgreSql": {
      "ConnectionStringName": "PostgresConnection",
      "CommandTimeoutSeconds": 30,
      "MaxRetryCount": 5,
      "MaxRetryDelaySeconds": 10
    },
    "Migration": {
      "Enabled": false,
      "BatchSize": 500,
      "RunSchemaMigrations": true,
      "AllowNonEmptyTarget": false,
      "SourceConnectionStringName": "DefaultConnection",
      "TargetConnectionStringName": "PostgresConnection"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=lynqmentrics.db",
    "PostgresConnection": "Host=YOUR_SUPABASE_HOST;Port=5432;Database=postgres;Username=postgres;Password=YOUR_SUPABASE_PASSWORD;SSL Mode=Require;Trust Server Certificate=true"
  },
  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "IpHashSalt": "LynqMentrics_MVP_Static_Salt_2026",
  "PiiEncryptionKey": "",
  "Compliance": {
    "DataRetentionEnabled": true,
    "DataRetentionDays": 365,
    "DataRetentionIntervalHours": 24,
    "ConsentVersion": "1.0"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
