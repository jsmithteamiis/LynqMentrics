@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="mx-auto grid max-w-5xl gap-8 lg:grid-cols-2">
    <section class="space-y-5">
        <p class="inline-flex rounded-full border border-brandCyan/40 bg-brandCyan/10 px-4 py-1 text-sm font-medium text-brandCyan">Welcome back</p>
        <h1 class="text-4xl font-extrabold tracking-tight text-white">Log in to LynqMentrics</h1>
        <p class="text-slate-300">Access your dashboard, manage links, and inspect analytics.</p>

        @if (Model.IsDemoPrefill)
        {
            <div class="rounded-xl border border-brandEmerald/40 bg-brandEmerald/10 p-4 text-sm text-brandEmerald">
                Demo credentials are pre-filled. Click <strong>Log in</strong> to explore LynqMentrics.
            </div>
        }
        else
        {
            <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-4 text-sm text-slate-300">
                Want to explore first? Use the demo account: <span class="font-semibold text-white">demo@lynqmentrics.com</span> / <span class="font-semibold text-white">Demo12345!</span>
            </div>
        }

        <a href="/Identity/Account/Login?demo=true" class="inline-flex items-center rounded-lg bg-brandCyan px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-cyan-300">Try the Demo</a>
    </section>

    <section class="rounded-2xl border border-slate-800 bg-slate-900/70 p-6 shadow-2xl shadow-brandIndigo/10">
        <h2 class="text-xl font-semibold text-white">Sign in</h2>
        <form id="account" method="post" class="mt-6 space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-sm text-rose-300" role="alert"></div>

            <div>
                <label asp-for="Input.Email" class="mb-1 block text-sm font-medium text-slate-200"></label>
                <input asp-for="Input.Email"
                       type="email"
                       class="w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-slate-100 outline-none transition focus:border-brandIndigo"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="name@example.com" />
                <span asp-validation-for="Input.Email" class="mt-1 block text-sm text-rose-300"></span>
            </div>

            <div>
                <label asp-for="Input.Password" class="mb-1 block text-sm font-medium text-slate-200"></label>
                <input asp-for="Input.Password"
                       type="password"
                       class="w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-slate-100 outline-none transition focus:border-brandIndigo"
                       autocomplete="current-password"
                       aria-required="true"
                       placeholder="password" />
                <span asp-validation-for="Input.Password" class="mt-1 block text-sm text-rose-300"></span>
            </div>

            <label class="flex items-center gap-2 text-sm text-slate-300">
                <input asp-for="Input.RememberMe" class="h-4 w-4 rounded border-slate-700 bg-slate-950 text-brandIndigo focus:ring-brandIndigo" />
                @Html.DisplayNameFor(m => m.Input.RememberMe)
            </label>

            <button id="login-submit" type="submit" class="inline-flex w-full items-center justify-center rounded-lg bg-brandIndigo px-4 py-2.5 text-sm font-semibold text-white hover:bg-indigo-500">
                Log in
            </button>
        </form>

        <div class="mt-6 flex flex-wrap gap-4 text-sm">
            <a id="forgot-password" asp-page="./ForgotPassword" class="text-brandCyan hover:underline">Forgot your password?</a>
            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-brandCyan hover:underline">Register</a>
            <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="text-brandCyan hover:underline">Resend confirmation</a>
        </div>
    </section>
</div>
