<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LynqMentrics</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://ajax.aspnetcdn.com/ajax/jquery/jquery-3.7.1.min.js"></script>
</head>
<body class="bg-slate-950 text-slate-100 font-sans min-h-screen">
    <header class="border-b border-slate-800 bg-slate-900/70 backdrop-blur">
        <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
            <a asp-page="/Index" class="text-xl font-extrabold tracking-tight text-white">Lyn<span class="text-brandCyan">q</span>Mentrics</a>
            <div class="flex items-center gap-4 text-sm font-medium">
                <a asp-page="/Index" class="text-slate-200 hover:text-white">Home</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-page="/Dashboard/Index" class="text-slate-200 hover:text-white">Dashboard</a>
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                        <button type="submit" class="inline-flex items-center rounded-md border border-slate-700 bg-slate-900 px-3 py-1.5 text-white hover:border-brandCyan" aria-label="Sign out">
                            Sign out
                        </button>
                    </form>
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Login" class="rounded-md border border-slate-700 px-3 py-1.5 text-slate-100 hover:border-brandCyan hover:text-white">Sign in</a>
                }
            </div>
        </nav>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
