@using System.Text.Json
@{
    // Read the consent decision stored by the banner (GDPR/CCPA). Google Fonts is a
    // third-party request (IP address is sent to Google), so it is only loaded when
    // the visitor has consented to analytics/preference cookies.
    var consentJson = Context.Request.Cookies["lynq_consent"];
    var hasConsent = !string.IsNullOrEmpty(consentJson);
    var analyticsAllowed = false;
    if (hasConsent)
    {
        try
        {
            using var doc = JsonDocument.Parse(consentJson!);
            analyticsAllowed = doc.RootElement.TryGetProperty("analytics", out var analytics) && analytics.GetBoolean();
        }
        catch (JsonException)
        {
            hasConsent = false;
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LynqMentrics</title>
    @if (analyticsAllowed)
    {
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    }
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" media="all" onload="this.onload=null" onerror="this.onerror=null" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://ajax.aspnetcdn.com/ajax/jquery/jquery-3.7.1.min.js" defer="defer" integrity="sha256-3e7l+6L92jKdMPWp9j81d7t+O3dawbfV3VhccZvFyQ=" crossorigin="anonymous"></script>
</head>
<body class="bg-slate-950 text-slate-100 font-sans min-h-screen flex flex-col">
  <!-- Skip link for keyboard navigation -->
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-0 focus:left-0 focus:z-50" aria-label="Skip to main content">
    Skip to main content
  </a>
  <a id="main"></a>
    <header class="border-b border-slate-800 bg-slate-900/70 backdrop-blur">
        <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8" aria-label="Main navigation" role="navigation">
            <a <a <a asp-page="/Index" class="text-xl font-extrabold tracking-tight text-white">Lyn<span class="text-brandCyan">q</span>Mentrics</a>
            <nav aria-label="Main navigation" role="navigation" class="flex items-center gap-4 text-sm font-medium">
                <a asp-page="/Index" class="text-slate-200 hover:text-white" aria-current="page" role="menuitem">Home</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-page="/Dashboard/Index" class="text-slate-200 hover:text-white">Dashboard</a>
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                        <button type="submit" class="inline-flex items-center rounded-md border border-slate-700 bg-slate-900 px-3 py-1.5 text-white hover:border-brandCyan" aria-label="Sign out">
                            Sign out
                        </button>
                    </form>
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Login" class="rounded-md border border-slate-700 px-3 py-1.5 text-slate-100 hover:border-brandCyan hover:text-white">Sign in</a>
                }
            </div>
        </nav>
    </header>

    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-10 sm:px-6 lg:px-8">
        @RenderBody()
    </main>

    <footer class="border-t border-slate-800 bg-slate-900/60">
        <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-4 py-6 text-xs text-slate-400 sm:flex-row sm:px-6 lg:px-8">
            <p>© @DateTime.UtcNow.Year LynqMentrics · KKGLabs</p>
            <div class="flex flex-wrap items-center gap-4">
                <a asp-page="/Privacy" class="hover:text-white">Privacy Center</a>
                <a asp-page="/Privacy/Policy" class="hover:text-white">Privacy Policy</a>
                <a asp-page="/Privacy/Terms" class="hover:text-white">Terms of Service</a>
                <a asp-page="/Privacy/Cookies" class="hover:text-white">Cookie Policy</a>
                <button type="button" id="cookie-settings-link" class="hover:text-white" style="background:none;border:none;padding:0;font:inherit;color:inherit;cursor:pointer">Cookie Settings</button>
            </div>
        </div>
    </footer>

    @if (!hasConsent)
    {
        <partial name="_CookieConsentPartial" />
    }

    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
